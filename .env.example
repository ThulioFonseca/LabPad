# Template de configuracao. Copie para .env e preencha:
#     cp .env.example .env
# O docker compose carrega o .env automaticamente.

# Fuso horario (formato IANA)
TZ=America/Sao_Paulo

# --- Agenda -------------------------------------------------------------------
# URL .ics de um calendario Outlook publicado.
# Como obter no Outlook web: Configuracoes -> Calendario -> Calendarios
# compartilhados -> Publicar calendario -> copie o link ICS (termina em .ics).
# Deixe vazio para desativar a secao Agenda.
CALENDAR_ICS_URL=
CALENDAR_DAYS=3

# --- Noticias -----------------------------------------------------------------
# URL de um feed RSS/Atom. Deixe vazio para desativar a secao Noticias.
NEWS_RSS_URL=
NEWS_LIMIT=5

# --- Clima --------------------------------------------------------------------
# Nome da cidade (Open-Meteo, gratis, sem chave). Vazio = secao desativada.
WEATHER_CITY=
